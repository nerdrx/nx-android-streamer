<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No INTERNET permission, on purpose: this app never talks to the network.
         Its only channel to the outside is a directory on /sdcard that the daemon
         reads over adb. An in-container helper that cannot open a socket is a
         much smaller thing to trust. -->

    <!-- "All files access". Optional and unrequested at runtime: with it granted
         the spool lives at the readable /sdcard/nx-bridge, without it we fall
         back to this app's own external files dir, which needs no permission at
         all. See Spool.kt. tools:ignore because there is no Play listing here —
         this APK is installed over adb into a container. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NXBridge">

        <!-- The launcher face: "waiting for requests" plus which spool root is in
             use, so the whole thing can be verified by hand without a daemon. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The point of the app: appear in the remote Android's picker chooser.
             GET_CONTENT is what nearly everything actually sends (share sheets,
             file inputs, "attach a photo"); PICK is the older gallery-style
             intent some apps still use. Both mime filters are listed separately
             because an intent-filter matches on ONE data element at a time and
             "*/*" alone does not always win against a concrete "image/*" query. -->
        <activity
            android:name=".PickerActivity"
            android:exported="true"
            android:label="@string/picker_label"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.NXBridge">
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- The chosen file is handed back as a content:// Uri, never a file://
             one: a file path in an intent result is a FileUriExposedException on
             anything past Android 7, and the calling app has no read access to
             our directory anyway. grantUriPermissions + FLAG_GRANT_READ_URI_PERMISSION
             on the result is what actually lets it read the bytes. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="dev.nerdrx.nxbridge.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
    </application>
</manifest>
